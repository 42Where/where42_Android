<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/layout_height_header"
    android:paddingStart="@dimen/layout_height_padding"
    android:paddingEnd="@dimen/layout_height_padding">

    <ImageView
        android:id="@+id/where42_logo"
        android:layout_width="@dimen/where42_logo_width"
        android:layout_height="@dimen/where42_logo_height"
        android:background="@drawable/list_title_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/where42_logo" />

<!--    android:layout_width="@dimen/header_setting_btn"-->
<!--    android:layout_height="@dimen/header_setting_btn"-->
    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="@dimen/edittext_layout_height"
        android:layout_height="@dimen/edittext_layout_height"
        android:src="@drawable/settings_icon"
        android:scaleType="centerInside"
        android:padding="0sp"
        android:backgroundTint="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/compass_button"
        android:visibility="visible"
        android:layout_width="@dimen/header_setting_btn"
        android:layout_height="@dimen/header_setting_btn"
        android:src="@drawable/ic_action_firrvector"
        android:scaleType="fitCenter"
        android:padding="0sp"
        android:backgroundTint="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/setting_button"
        app:layout_constraintTop_toTopOf="parent"/>


    <ImageButton
        android:id="@+id/ann_button"
        android:layout_width="@dimen/header_setting_btn"
        android:layout_height="@dimen/header_setting_btn"
        android:src="@drawable/ic_action_megaphone"
        android:visibility="gone"
        android:padding="0sp"
        android:backgroundTint="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/compass_button"
        app:layout_constraintTop_toTopOf="parent"/>



</androidx.constraintlayout.widget.ConstraintLayout>