<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <include
        android:id="@+id/header"
        layout="@layout/activity_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="클러스터 실시간 현황"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#132743"
                android:layout_marginBottom="12dp"/>

            <!-- 클러스터 별 이용률 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="클러스터 별 이용률"
                    android:textSize="15sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/pie_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:orientation="horizontal"/>

                <LinearLayout
                    android:id="@+id/pie_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:orientation="horizontal"/>

                <LinearLayout
                    android:id="@+id/pie_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:orientation="horizontal"/>

                <!-- 범례 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/circle_available"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 사용 가능 자리"
                        android:textSize="12sp"
                        android:layout_marginEnd="20dp"/>
                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/circle_inuse"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 사용 중인 자리"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- iMac 사용 현황 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_background"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="클러스터 iMac 사용 현황"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(iMac 로그인 인원 / 출석 태깅한 인원)"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42 / 100"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#132743"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

            <!-- member 정보 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="member님의 정보"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#132743"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_background"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="지난주에 자주 앉은 자리"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자리 정보가 없습니다"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- 42Seoul 인기자리 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42Seoul 인기자리"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#132743"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="지난주 인기자리"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"/>

                <!-- 1위 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                        android:text="1" android:textSize="15sp" android:textStyle="bold" android:textColor="#132743"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="C2R6S1" android:textSize="15sp" android:textStyle="bold" android:textColor="#132743"/>
                </LinearLayout>
                <!-- 2위 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                        android:text="2" android:textSize="14sp" android:textColor="#444444"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="C1R3S4" android:textSize="14sp" android:textColor="#444444"/>
                </LinearLayout>
                <!-- 3위 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                        android:text="3" android:textSize="14sp" android:textColor="#444444"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="C5R2S7" android:textSize="14sp" android:textColor="#444444"/>
                </LinearLayout>
                <!-- 4위 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                        android:text="4" android:textSize="14sp" android:textColor="#444444"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="C6R4S3" android:textSize="14sp" android:textColor="#444444"/>
                </LinearLayout>
                <!-- 5위 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                        android:text="5" android:textSize="14sp" android:textColor="#444444"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CX1R1S2" android:textSize="14sp" android:textColor="#444444"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/footer"
        layout="@layout/activity_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
