<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/header"
        layout="@layout/activity_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Text Announcement -->
            <TextView
                android:id="@+id/text_cluster_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/scrollview"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_medium_change"
                android:fontFamily="@font/gmarketsans_bold"
                android:text="클러스터 실시간 현황"
                />

            <TextView
                android:id="@+id/text_cluster_live_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center"
                android:textColor="#132743"
                android:textSize="@dimen/font_medium_change"
                android:fontFamily="@font/gmarketsans_medium"
                android:text="클러스터 실시간 현황"
                />
            <!-- GridLayout -->
            <GridLayout
                android:id="@+id/chart_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="16dp">

                <!-- 첫 번째 차트와 텍스트 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/chart_c1"
                        android:layout_width="150dp"
                        android:layout_height="150dp" />

                    <TextView
                        android:id="@+id/label_c1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="C1"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- 두 번째 차트와 텍스트 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/chart_c2"
                        android:layout_width="150dp"
                        android:layout_height="150dp" />

                    <TextView
                        android:id="@+id/label_c2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="C2"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- 두 번째 차트와 텍스트 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/chart_c5"
                        android:layout_width="150dp"
                        android:layout_height="150dp" />

                    <TextView
                        android:id="@+id/label_c5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="C5"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- 두 번째 차트와 텍스트 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/chart_c6"
                        android:layout_width="150dp"
                        android:layout_height="150dp" />

                    <TextView
                        android:id="@+id/label_c6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="C6"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- 두 번째 차트와 텍스트 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/chart_cx1"
                        android:layout_width="150dp"
                        android:layout_height="150dp" />

                    <TextView
                        android:id="@+id/label_cx1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="CX1"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- 두 번째 차트와 텍스트 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/chart_cx2"
                        android:layout_width="150dp"
                        android:layout_height="150dp" />

                    <TextView
                        android:id="@+id/label_cx2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="CX2"
                        android:textAlignment="center" />
                </LinearLayout>
            </GridLayout>

            <TextView
                android:id="@+id/text_cluster_live_usagestatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/scrollview"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_medium_change"
                android:fontFamily="@font/gmarketsans_medium"
                android:text="클러스터 사용 현황 현황"
                />
            <TextView
                android:id="@+id/text_cluster_live_explain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/scrollview"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_medium_change"
                android:fontFamily="@font/gmarketsans_medium"
                android:text="(맥 로그인 인원/ 개포에 있는 인원)"
                />

            <TextView
                android:id="@+id/cluster_live_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/scrollview"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_medium_change"
                android:fontFamily="@font/gmarketsans_medium"
                android:layout_marginTop="10dp"
                android:text="10 / 100"
                />

        </LinearLayout>

    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>