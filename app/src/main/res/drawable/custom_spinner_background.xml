<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/newgroup_button_padding" />
            <stroke
                android:width="1dp"
                android:color="@android:color/black" />
        </shape>
    </item>


    <item android:right="@dimen/location_info"
        android:tint="#132743"
        android:drawable="@drawable/ic_action_fi_sr_angle_down"
        android:gravity="end|center_vertical">
    </item>
</layer-list>

